{
  "expo": {
    "name": "Gitarre ueben",
    "slug": "gitarren-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.gitarrenuebung"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14110f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.gitarrenuebung"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-audio",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Die App hoert deiner Gitarre zu (Stimmgeraet, Mitscrollen).",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ],
          "androidForegroundService": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Fuer die Spracheingabe bei der Liedersuche.",
          "speechRecognitionPermission": "Fuer die Spracheingabe bei der Liedersuche."
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/gitarren-app"
    }
  }
}